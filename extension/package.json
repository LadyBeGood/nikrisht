{
    "name": "nikrisht",
    "displayName": "Nikrisht",
    "description": "Official language support for the Nikrisht programming language.",
    "repository": {
        "type": "git",
        "url": "https://github.com/LadyBeGood/nikrisht"
    },
    "version": "0.0.2",
    "publisher": "LadyBeGood",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Other"
    ],
    "license": "UNLICENSED",
    "icon": "./assets/nki.png",
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "nikrisht.run",
                "title": "Run",
                "icon": "$(run)"
            }
        ],
        "languages": [
            {
                "id": "nikrisht",
                "aliases": [ "Nikrisht" ],
                "extensions": [ ".nki" ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/nki-light.svg",
                    "dark": "./assets/nki-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "nikrisht",
                "scopeName": "source.nikrisht",
                "path": "./syntaxes/nikrisht.json"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "resourceLangId == nikrisht",
                    "command": "nikrisht.run",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "copy-assets": "node ./src/copy-assets.js",
        "build": "npm run copy-assets && esbuild src/extension.js --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
        "vscode:prepublish": "npm run build"
    },
    "devDependencies": {
        "@types/vscode": "^1.107.0",
        "eslint": "^10.5.0"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "esbuild": "^0.28.2"
    }
}
