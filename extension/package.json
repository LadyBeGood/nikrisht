{
    "name": "nikrisht",
    "displayName": "Nikrisht",
    "description": "Official language support for the Nikrisht programming language.",
    "repository": {
        "type": "git",
        "url": "https://github.com/LadyBeGood/nikrisht"
    },
    "version": "0.0.1",
    "publisher": "LadyBeGood",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Other"
    ],
    "type": "module",
    "activationEvents": [],
    "main": "./src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "nikrisht.run",
                "title": "Run",
                "icon": "$(run)"
            }
        ],
        "languages": [
            {
                "id": "nikrisht",
                "aliases": [
                    "Nikrisht"
                ],
                "extensions": [
                    ".nki"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "nikrisht",
                "scopeName": "source.nikrisht",
                "path": "./syntaxes/nikrisht.json"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "when": "resourceLangId == nikrisht",
                    "command": "nikrisht.run",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "pretest": "npm run lint",
        "lint": "eslint .",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.134.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "typescript-eslint": "^8.61.1",
        "eslint": "^10.5.0",
        "typescript": "^6.0.3",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}