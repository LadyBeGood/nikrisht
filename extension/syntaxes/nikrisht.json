{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Nikrisht",
    "scopeName": "source.nikrisht",
    "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#literals" },
        { "include": "#strings" },
        { "include": "#functions" },
        { "include": "#identifiers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "include": "#blockComment" },
                { "include": "#lineComment" }
            ]
        },
        "blockComment": {
            "name": "comment.block.nikrisht",
            "begin": "#\\*",
            "end": "\\*#",
            "patterns": [
                { "include": "#blockComment" }
            ]
        },
        "lineComment": {
            "name": "comment.line.nikrisht",
            "match": "#.*$"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.nikrisht",
                    "match": "\\b(if|else|loop|with|exit|skip|return)\\b"
                },
                {
                    "name": "keyword.declaration.nikrisht",
                    "match": "\\b(var|const|func)\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.language.nikrisht",
                    "match": "\\b(true|false|null)\\b"
                },
                {
                    "name": "constant.numeric.nikrisht",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.nikrisht",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.nikrisht",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.nikrisht",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.nikrisht",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)?\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.nikrisht"
                        },
                        "2": {
                            "name": "entity.name.function.nikrisht"
                        }
                    }
                },
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.nikrisht"
                        }
                    }
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.readwrite.nikrisht",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.range.nikrisht",
                    "match": "\\.\\.<|\\.\\.>|\\.\\."
                },
                {
                    "name": "keyword.operator.comparison.nikrisht",
                    "match": "==|!=|>=|<=|>|<"
                },
                {
                    "name": "keyword.operator.logical.nikrisht",
                    "match": "\\||&|!"
                },
                {
                    "name": "keyword.operator.assignment.nikrisht",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.nikrisht",
                    "match": "\\+|-|\\*|/"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.terminator.statement.nikrisht",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.nikrisht",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.nikrisht",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.key-value.nikrisht",
                    "match": ":"
                },
                {
                    "name": "punctuation.section.parens.nikrisht",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.section.brackets.nikrisht",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.section.braces.nikrisht",
                    "match": "[{}]"
                }
            ]
        }
    }
}